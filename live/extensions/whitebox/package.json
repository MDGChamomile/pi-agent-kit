{
  "name": "pi-whitebox",
  "version": "0.1.0",
  "private": true,
  "description": "A strict offline Bubblewrap boundary for running untrusted project commands with Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDGChamomile/pi-agent-kit.git",
    "directory": "live/extensions/whitebox"
  },
  "homepage": "https://github.com/MDGChamomile/pi-agent-kit/tree/main/live/extensions/whitebox",
  "bugs": "https://github.com/MDGChamomile/pi-agent-kit/issues",
  "type": "module",
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sandbox",
    "bubblewrap"
  ],
  "bin": {
    "piw": "./bin/piw.mjs"
  },
  "files": [
    "bin/",
    "file-boundary.ts",
    "file-worker.ts",
    "index.ts",
    "README.md",
    "README.ko.md",
    "SECURITY.md",
    "sandbox.test.ts",
    "sandbox.ts",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test sandbox.test.ts",
    "test:portable": "node --experimental-strip-types --test --test-name-pattern='^(pure policy and argument construction|Pi extension wiring with a fake API)$' sandbox.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
